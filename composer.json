{
    "name": "yilmazmurad/cronkit",
    "description": "Zero-dependency cron expression library for PHP 8.3+: parsing, next/previous runs, DST-correct time zones, Vixie semantics and human-readable descriptions.",
    "type": "library",
    "license": "MIT",
    "keywords": ["cron", "crontab", "scheduler", "cron-expression", "schedule", "dst", "timezone"],
    "authors": [
        {
            "name": "Murat Yılmaz",
            "homepage": "https://github.com/yilmazmurad"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "YilmazMurad\\Cronkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YilmazMurad\\Cronkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
